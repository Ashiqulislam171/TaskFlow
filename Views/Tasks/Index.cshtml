
@model IEnumerable<TaskFlow.Models.TaskItem>

@{
    ViewData["Title"] = "My Tasks";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">My Tasks</h1>
            <p class="text-secondary">Manage all your tasks in one place.</p>
        </div>

        <a asp-controller="Home" asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Task</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Due Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@task.Title</strong>
                                        <div class="small text-secondary">
                                            @task.Description
                                        </div>
                                    </td>
                                    <td>@task.Priority</td>
                                    <td>@task.Status</td>
                                    <td>
                                        @(task.DueDate?.ToString("dd MMM yyyy") ?? "No due date")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h4>No tasks yet</h4>
                    <p class="text-secondary">
                        Your tasks will appear here when you add them.
                    </p>
                </div>
            }
        </div>
    </div>
</div>
