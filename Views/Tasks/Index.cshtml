
@model IEnumerable<TaskFlow.Models.TaskItem>

@{
    ViewData["Title"] = "My Tasks";
    var tasks = Model.ToList();
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold">My Tasks</h1>
            <p class="text-secondary mb-0">
                Manage all your tasks in one place.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-primary">
                + Create Task
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- Search and Filter -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">

                    <div class="col-12 col-md-4">
                        <label for="searchTerm" class="form-label">
                            Search by Title
                        </label>

                        <input type="text"
                               id="searchTerm"
                               name="searchTerm"
                               value="@ViewBag.SearchTerm"
                               class="form-control"
                               placeholder="Enter task title..." />
                    </div>

                    <div class="col-12 col-md-3">
                        <label for="status" class="form-label">
                            Status Filter
                        </label>

                        <select id="status"
                                name="status"
                                class="form-select">
                            <option value="">All Statuses</option>
                            <option value="Pending"
                                    selected="@(ViewBag.SelectedStatus == "Pending")">
                                Pending
                            </option>
                            <option value="In Progress"
                                    selected="@(ViewBag.SelectedStatus == "In Progress")">
                                In Progress
                            </option>
                            <option value="Completed"
                                    selected="@(ViewBag.SelectedStatus == "Completed")">
                                Completed
                            </option>
                        </select>
                    </div>

                    <div class="col-12 col-md-3">
                        <label for="priority" class="form-label">
                            Priority Filter
                        </label>

                        <select id="priority"
                                name="priority"
                                class="form-select">
                            <option value="">All Priorities</option>
                            <option value="Low"
                                    selected="@(ViewBag.SelectedPriority == "Low")">
                                Low
                            </option>
                            <option value="Medium"
                                    selected="@(ViewBag.SelectedPriority == "Medium")">
                                Medium
                            </option>
                            <option value="High"
                                    selected="@(ViewBag.SelectedPriority == "High")">
                                High
                            </option>
                        </select>
                    </div>

                    <div class="col-12 col-md-2 d-flex align-items-end gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Search
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- Task List -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h5 class="fw-bold mb-0">Task List</h5>

                <span class="badge bg-primary">
                    @tasks.Count Tasks
                </span>
            </div>

            @if (tasks.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Task</th>
                                <th scope="col">Priority</th>
                                <th scope="col">Status</th>
                                <th scope="col">Due Date</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var task in tasks)
                            {
                                <tr>
                                    <td class="text-break">
                                        <strong>@task.Title</strong>

                                        @if (!string.IsNullOrWhiteSpace(task.Description))
                                        {
                                            <div class="small text-secondary mt-1">
                                                @task.Description
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        @if (task.Priority == "High")
                                        {
                                            <span class="badge bg-danger">
                                                High
                                            </span>
                                        }
                                        else if (task.Priority == "Medium")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Medium
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                @task.Priority
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (task.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (task.Status == "In Progress")
                                        {
                                            <span class="badge bg-primary">
                                                In Progress
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @task.Status
                                            </span>
                                        }

                                        <form asp-action="UpdateStatus"
                                              method="post"
                                              class="mt-2">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@task.Id" />

                                            <label class="visually-hidden"
                                                   for="status-@task.Id">
                                                Change status for @task.Title
                                            </label>

                                            <select id="status-@task.Id"
                                                    name="status"
                                                    class="form-select form-select-sm mb-2">
                                                <option value="Pending"
                                                        selected="@(task.Status == "Pending")">
                                                    Pending
                                                </option>

                                                <option value="In Progress"
                                                        selected="@(task.Status == "In Progress")">
                                                    In Progress
                                                </option>

                                                <option value="Completed"
                                                        selected="@(task.Status == "Completed")">
                                                    Completed
                                                </option>
                                            </select>

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                Update Status
                                            </button>
                                        </form>
                                    </td>

                                    <td>
                                       @if (task.DueDate.HasValue &&
     task.DueDate.Value < DateOnly.FromDateTime(DateTime.Today) &&
     task.Status != "Completed")
                                        {
                                            <span class="badge bg-danger">
                                                Overdue
                                            </span>

                                            <div class="small text-danger mt-1">
                                                @task.DueDate.Value.ToString("dd MMM yyyy")
                                            </div>
                                        }
                                        else
                                        {
                                            @(task.DueDate?.ToString("dd MMM yyyy") ?? "No due date")
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-action="Edit"
                                               asp-route-id="@task.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@task.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h4>No tasks found</h4>

                    <p class="text-secondary">
                        Try changing your search or filters,
                        or create a new task.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Create Task
                    </a>
                </div>
            }

        </div>
    </div>

</div>
