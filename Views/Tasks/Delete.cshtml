
@model TaskFlow.Models.TaskItem

@{
    ViewData["Title"] = "Delete Task";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 fw-bold text-danger">Delete Task</h1>

                    <p class="text-secondary">
                        Are you sure you want to delete this task?
                        This action cannot be undone.
                    </p>

                    <hr />

                    <h5>@Model.Title</h5>
                    <p class="text-secondary">@Model.Description</p>

                    <p>
                        <strong>Priority:</strong> @Model.Priority
                    </p>

                    <p>
                        <strong>Status:</strong> @Model.Status
                    </p>

                    <form asp-action="DeleteConfirmed"
                          asp-route-id="@Model.Id"
                          method="post">
                        <button type="submit" class="btn btn-danger">
                            Yes, Delete
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
