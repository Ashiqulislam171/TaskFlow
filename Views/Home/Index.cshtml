
@model TaskFlow.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var completionPercentage = Model.TotalTasks > 0
        ? (int)Math.Round(
            (double)Model.CompletedTasks / Model.TotalTasks * 100)
        : 0;
}

<div class="container py-4">

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h1 class="fw-bold">Welcome to TaskFlow</h1>
                <p class="text-secondary mb-0">
                    Organize your work and keep track of your progress.
                </p>
            </div>

            <a asp-controller="Tasks" asp-action="Create"
               class="btn btn-primary">
                + Create Task
            </a>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary mb-2">Total Tasks</p>
                        <h2 class="fw-bold">@Model.TotalTasks</h2>
                        <small class="text-secondary">All your tasks</small>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary mb-2">Pending</p>
                        <h2 class="fw-bold text-warning">@Model.PendingTasks</h2>
                        <small class="text-secondary">Waiting to start</small>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary mb-2">In Progress</p>
                        <h2 class="fw-bold text-primary">@Model.InProgressTasks</h2>
                        <small class="text-secondary">Currently working</small>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary mb-2">Completed</p>
                        <h2 class="fw-bold text-success">@Model.CompletedTasks</h2>
                        <small class="text-secondary">Tasks finished</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Overall Progress -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <h4 class="fw-bold mb-1">Overall Progress</h4>
                        <p class="text-secondary mb-0">
                            Track your task completion.
                        </p>
                    </div>
                    <h3 class="fw-bold text-success mb-0">
                        @completionPercentage%
                    </h3>
                </div>

                <div class="progress mt-3"
                     role="progressbar"
                     aria-label="Task completion progress"
                     aria-valuenow="@completionPercentage"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     style="height: 14px;">
                    <div class="progress-bar bg-success"
                         style="width: @completionPercentage%;">
                    </div>
                </div>

                <small class="text-secondary d-block mt-2">
                    @Model.CompletedTasks of @Model.TotalTasks tasks completed
                </small>
            </div>
        </div>

        <!-- Recent Tasks -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h4 class="fw-bold mb-1">Recent Tasks</h4>
                        <p class="text-secondary mb-0">
                            Your latest tasks at a glance.
                        </p>
                    </div>

                    <a asp-controller="Tasks" asp-action="Index"
                       class="btn btn-outline-primary">
                        View All
                    </a>
                </div>

                @if (Model.RecentTasks.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Task</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th>Due Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in Model.RecentTasks)
                                {
                                    <tr>
                                        <td>
                                            <strong>@task.Title</strong>
                                        </td>
                                        <td>@task.Priority</td>
                                        <td>
                                            @if (task.Status == "Completed")
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                            else if (task.Status == "In Progress")
                                            {
                                                <span class="badge bg-primary">In Progress</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Pending</span>
                                            }
                                        </td>
                                        <td>
                                            @(task.DueDate?.ToString("dd MMM yyyy") ?? "No due date")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <h5>No tasks yet</h5>
                        <p class="text-secondary">
                            Create your first task to see your dashboard statistics.
                        </p>
                        <a asp-controller="Tasks" asp-action="Create"
                           class="btn btn-primary">
                            Create Your First Task
                        </a>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <h1 class="display-4 fw-bold">Welcome to TaskFlow</h1>
            <p class="lead text-secondary">
                Organize your work and keep track of your progress.
            </p>

            <a asp-controller="Account" asp-action="Register"
               class="btn btn-primary btn-lg me-2">
                Get Started
            </a>

            <a asp-controller="Account" asp-action="Login"
               class="btn btn-outline-primary btn-lg">
                Login
            </a>
        </div>
    }

</div>
